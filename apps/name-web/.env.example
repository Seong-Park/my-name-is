# Copy to .env.local; keep keys on the server. Never use NEXT_PUBLIC for AI keys.
DEEPSEEK_API_KEY=
DATABASE_URL=
# Server-only 32-byte random signing secret, encoded as 64 hexadecimal characters.
NAME_RECEIPT_SECRET=
NAME_WEB_ORIGIN=http://127.0.0.1:3100

# Optional public Kakao JavaScript key; configure allowed service domains first.
NEXT_PUBLIC_KAKAO_JS_KEY=
